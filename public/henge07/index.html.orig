        #loader {
            position: fixed;
            z-index: 1000;
            background: #171719;
            width: 100%;
            height: 100vh;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: all 1s cubic-bezier(0.74, 0, 0.15, 0.99) .2s;
            pointer-events: none;
        }

        #loader.ready {
            opacity: 0;
        }

        #loader__logo {
            fill: #fff;
            width: 85px;
            height: 17px;
            transition: opacity .5s ease-out;
        }

        #loader.ready #loader__percentage {
            transition-duration: .2s;
        }

        #loader__percentage {
            width: 85px;
            height: 1px;
            background: #fff;
            margin-top: 15px;
            transform-origin: 0% 0%;
            transform: scaleX(0);
            transition: transform .1s ease-out;
        }
    </style>
